# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Local Claude Code config (machine-specific)
# Local Claude Code session state, but skills and slash-commands
# committed under .claude/ should be shared with the repo.
.claude/*
!.claude/skills/
!.claude/commands/

# typescript
*.tsbuildinfo
next-env.d.ts
